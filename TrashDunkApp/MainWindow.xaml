<Window x:Class="TrashDunkApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrashDunk"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    
    <Grid Background="#B005080E">
        <!-- Bannière d'aide en haut -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"
                Background="#20FFFFFF" CornerRadius="12" Padding="20,10" BorderBrush="#35FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏀 TrashDunk" FontWeight="Bold" FontSize="18" Foreground="#FF5E20" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <TextBlock Text="Fichier cible : " Foreground="#99FFFFFF" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtFileName" Text="fichier.txt" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="14" Margin="5,0,20,0" VerticalAlignment="Center"/>
                <TextBlock Text="[Espace] / [Clic] pour Dunker | [Échap] pour Annuler" Foreground="#70FFFFFF" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Stats / Streak en haut à droite -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,40,0"
                Background="#20000000" CornerRadius="8" Padding="15,8" BorderBrush="#30FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Dunks: " Foreground="#88FFFFFF" FontSize="13"/>
                <TextBlock x:Name="TxtTotalDunks" Text="0" FontWeight="Bold" Foreground="#42D392" Margin="0,0,15,0" FontSize="13"/>
                <TextBlock Text="Streak: " Foreground="#88FFFFFF" FontSize="13"/>
                <TextBlock x:Name="TxtCurrentStreak" Text="0" FontWeight="Bold" Foreground="#FF9F1C" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Zone de Jeu Principale -->
        <Canvas x:Name="GameCanvas">
            <!-- Panier de basket / Corbeille -->
            <Canvas x:Name="HoopCanvas" Canvas.Left="0" Canvas.Top="0">
                <!-- Panneau arrière (Backboard) -->
                <Border Width="16" Height="140" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="2" CornerRadius="3"
                        Canvas.Left="0" Canvas.Top="0"/>
                <!-- Tige support -->
                <Rectangle Width="45" Height="8" Fill="#FF3E00" Canvas.Left="16" Canvas.Top="70"/>
                <!-- Anneau du panier -->
                <Border Width="95" Height="14" BorderBrush="#FF5E20" BorderThickness="4" CornerRadius="6"
                        Background="Transparent" Canvas.Left="55" Canvas.Top="67"/>
                <!-- Filet stylisé -->
                <Polygon Points="57,75 148,75 130,150 75,150"
                         Stroke="#FFFFFF" StrokeThickness="2" Fill="#15FFFFFF" Opacity="0.8"/>
            </Canvas>

            <!-- Ballon / Fichier -->
            <Canvas x:Name="BallCanvas" Canvas.Left="200" Canvas.Top="500" Width="80" Height="80">
                <Ellipse Width="70" Height="70" Fill="#FF5E20" Stroke="#1E0700" StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="25" Color="#FF3A00" Opacity="0.8"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Motif basket -->
                <Path Data="M 10,35 Q 35,5 60,35 M 10,35 Q 35,65 60,35 M 35,5 L 35,65 M 5,35 L 65,35"
                      Stroke="#1E0700" StrokeThickness="2.5" Opacity="0.6"/>
                <TextBlock Text="📄" FontSize="26" Canvas.Left="21" Canvas.Top="16"/>
            </Canvas>
        </Canvas>

        <!-- Jauge d'adresse / timing en bas -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,50">
            <TextBlock x:Name="TxtFeedback" Text="VERROUILLEZ DANS LA ZONE VERTE !" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            
            <Border Width="380" Height="36" Background="#1B2230" CornerRadius="18" BorderBrush="#45FFFFFF" BorderThickness="2">
                <Grid>
                    <!-- Zone de Swish / Réussite (Verte) -->
                    <Border x:Name="ZoneGreen" HorizontalAlignment="Center" Width="90" Background="#3542D392" BorderBrush="#42D392" BorderThickness="1.5" CornerRadius="4"/>
                    <!-- Curseur oscillant -->
                    <Border x:Name="GaugeNeedle" Width="8" Height="34" Background="#FFFFFF" CornerRadius="4" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#FFFFFF"/>
                        </Border.Effect>
                    </Border>
                </Grid>
            </Border>

            <!-- Boutons / Options -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="TIRER (ESPACE)" Padding="22,10" Background="#FF5E20" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                        BorderThickness="0" Cursor="Hand" Click="BtnShoot_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Activer Menu Clic Droit" Margin="15,0,0,0" Padding="15,10" Background="#223348" Foreground="#88FFFFFF"
                        FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnRegisterMenu_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
